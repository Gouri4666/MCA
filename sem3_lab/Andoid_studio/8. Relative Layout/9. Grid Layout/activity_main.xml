<?xml version="1.0" encoding="utf-8"?>

<GridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:columnCount="4"
    android:rowCount="6"
    android:padding="10dp"

    tools:context=".MainActivity">

    <!-- Display -->

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_columnSpan="4"
        android:gravity="right|center_vertical"
        android:padding="10dp"
        android:text="0"
        android:textSize="32sp" />

    <!-- Empty spaces + C button -->

    <Space
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="0"
        android:layout_row="1"
        android:layout_columnWeight="1" />

    <Space
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="1"
        android:layout_row="1"
        android:layout_columnWeight="1" />

    <Space
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="2"
        android:layout_row="1"
        android:layout_columnWeight="1" />

    <Button
        android:id="@+id/clear"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="3"
        android:layout_row="1"
        android:layout_columnWeight="1"
        android:backgroundTint="#F44336"
        android:onClick="onClick"
        android:text="C"
        android:textColor="#FFFFFF"
        android:textSize="22sp" />

    <!-- 7 8 9 + -->

    <Button
        android:id="@+id/seven"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="0"
        android:layout_row="2"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="7"
        android:textSize="22sp" />

    <Button
        android:id="@+id/eight"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="1"
        android:layout_row="2"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="8"
        android:textSize="22sp" />

    <Button
        android:id="@+id/nine"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="2"
        android:layout_row="2"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="9"
        android:textSize="22sp" />

    <Button
        android:id="@+id/add"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="3"
        android:layout_row="2"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="+"
        android:textSize="22sp" />

    <!-- 4 5 6 - -->

    <Button
        android:id="@+id/four"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="0"
        android:layout_row="3"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="4"
        android:textSize="22sp" />

    <Button
        android:id="@+id/five"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="1"
        android:layout_row="3"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="5"
        android:textSize="22sp" />

    <Button
        android:id="@+id/six"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="2"
        android:layout_row="3"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="6"
        android:textSize="22sp" />

    <Button
        android:id="@+id/diff"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="3"
        android:layout_row="3"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="-"
        android:textSize="22sp" />

    <!-- 1 2 3 * -->

    <Button
        android:id="@+id/one"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="0"
        android:layout_row="4"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="1"
        android:textSize="22sp" />

    <Button
        android:id="@+id/two"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="1"
        android:layout_row="4"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="2"
        android:textSize="22sp" />

    <Button
        android:id="@+id/three"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="2"
        android:layout_row="4"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="3"
        android:textSize="22sp" />

    <Button
        android:id="@+id/mul"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="3"
        android:layout_row="4"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="*"
        android:textSize="22sp" />

    <!-- . 0 = / -->

    <Button
        android:id="@+id/dot"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="0"
        android:layout_row="5"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="."
        android:textSize="22sp" />

    <Button
        android:id="@+id/zero"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="1"
        android:layout_row="5"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="0"
        android:textSize="22sp" />

    <Button
        android:id="@+id/equal"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="2"
        android:layout_row="5"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="="
        android:textSize="22sp" />

    <Button
        android:id="@+id/div"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:layout_column="3"
        android:layout_row="5"
        android:layout_columnWeight="1"
        android:onClick="onClick"
        android:text="/"
        android:textSize="22sp" />

</GridLayout>
